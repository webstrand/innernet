#!/usr/bin/env bash
# End-to-end test of the DNS server: answering for the names of the peers, and forwarding queries
# to the nameservers of the peers that the config selects, run unprivileged in network namespaces.
#
# Usage: scripts/e2e-dns [--keep]
#
# Topology, inside a private user, mount and network namespace:
#
#   198.18.0.0/24 "internet" (bridge in the outer namespace)
#     srv     198.18.0.1   innernet-server, whose DNS server runs at 127.0.0.1:5353 and forwards
#                          to every peer
#     a       198.18.0.2   peer whose daemon runs a DNS server at 127.0.0.1:5353
#     b       198.18.0.3   peer that offers a nameserver, dnsmasq, at its own address, and claims
#                          a range whose addresses the nameserver answers with
#     c       198.18.0.4   peer without a nameserver
#
# The binaries are those of the workspace, built into $CARGO_TARGET_DIR, or target/ if it is
# unset.
#
# Requires: unshare, ip, wg, sqlite3, python3 (3.11+), dnsmasq, dig, and the kernel WireGuard
# module.
set -euo pipefail

if [ -z "${E2E_INSIDE:-}" ]; then
    top=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
    cargo build --offline --bins --manifest-path "$top/Cargo.toml" >&2
    exec unshare --user --map-root-user --mount --net \
        env E2E_INSIDE=1 E2E_BIN="${CARGO_TARGET_DIR:-$top/target}/debug" "$0" "$@"
fi

keep=0
[ "${1:-}" = --keep ] && keep=1

mount -t tmpfs tmpfs /run
umask 077
work=$(mktemp -d "${TMPDIR:-/tmp}/innernet-e2e.XXXXXX")
pids=()
cleanup() {
    local status=$?
    for pid in "${pids[@]}"; do kill "$pid" 2>/dev/null || true; done
    if [ "$status" -ne 0 ]; then
        echo "--- server log" >&2
        tail -n 30 "$work/srv.log" >&2 || true
        echo "--- daemon log of a" >&2
        tail -n 30 "$work/a.daemon.log" >&2 || true
    fi
    if [ "$keep" -eq 1 ] || [ "$status" -ne 0 ]; then
        echo "work directory kept: $work" >&2
    else
        rm -rf "$work"
    fi
}
trap cleanup EXIT

step() { printf '\n=== %s\n' "$*"; }
pass() { printf 'ok: %s\n' "$*"; }
fail() { printf 'FAIL: %s\n' "$*" >&2; exit 1; }

ns() { local name=$1; shift; ip netns exec "$name" "$@"; }

server() { ns srv "$E2E_BIN/innernet-server" -c "$work/srv/conf" -d "$work/srv/data" "$@"; }
client() {
    local peer=$1; shift
    ns "$peer" "$E2E_BIN/innernet" -c "$work/$peer/conf" -d "$work/$peer/data" "$@" \
        >"$work/$peer.log" 2>&1 || { cat "$work/$peer.log" >&2; return 1; }
}

# Waits until the coordinator of the server in the namespace `$1`, whose config is `$2`, listens
# for its API, which the admin commands of innernet-server reach it at.
await_coordinator() { # <namespace> <config>
    local port
    for _ in $(seq 50); do
        port=$(python3 -I -c 'import sys, tomllib
c = tomllib.load(open(sys.argv[1], "rb"))
print(c.get("coordinator", c).get("quic-port", ""))' "$2")
        if [ -n "$port" ] && ip netns exec "$1" ss -Hlun "sport = :$port" | grep -q .; then
            return 0
        fi
        sleep 0.2
    done
    echo "FAIL: the coordinator in $1 doesn't listen" >&2
    exit 1
}

# Prints a field of an invitation or a config.
field() { # <file> <table> <key>
    python3 -I -c 'import sys, tomllib; print(tomllib.load(open(sys.argv[1], "rb"))[sys.argv[2]][sys.argv[3]])' "$@"
}

# Sets, or with no value removes, a key of the interface section of a client's config.
set_interface() { # <peer> <key> [TOML value]
    python3 -I - "$work/$1/conf/e2e.conf" "$2" "${3:-}" <<'EOF'
import re, sys
path, key, value = sys.argv[1:]
text = re.sub(rf'(?m)^{re.escape(key)} = .*\n', '', open(path).read())
if value:
    text = text.replace('[interface]\n', f'[interface]\n{key} = {value}\n', 1)
open(path, "w").write(text)
EOF
}

# Adds, or with no address removes, the [dns] table of the config of a peer or of the server,
# srv, with the TOML value of its forward key, if any.
set_dns() { # <peer> [listen address] [forward]
    python3 -I - "$work/$1/conf/e2e.conf" "${2:-}" "${3:-}" <<'EOF'
import re, sys
path, listen, forward = sys.argv[1:]
text = re.sub(r'(?m)^\[dns\]\nlisten = .*\n(forward = .*\n)?', '', open(path).read())
if listen:
    text = text.rstrip('\n') + f'\n\n[dns]\nlisten = "{listen}"\n'
    if forward:
        text += f'forward = {forward}\n'
open(path, "w").write(text)
EOF
}

dig_a() { ns a dig @127.0.0.1 -p 5353 +time=2 +tries=1 "$@"; }

# Waits until the DNS server of a resolves www.b.e2e.wg from b's nameserver, or fails.
await_forwarding() {
    for _ in $(seq 30); do
        [ "$(dig_a +short www.b.e2e.wg A 2>/dev/null)" = 10.66.1.34 ] && return 0
        sleep 0.5
    done
    fail "a doesn't resolve www.b.e2e.wg: $(dig_a www.b.e2e.wg A 2>&1)"
}

step "network"
ip link set lo up
ip link add br0 type bridge
ip link set br0 up
address=1
for name in srv a b c; do
    ip netns add "$name"
    ns "$name" ip link set lo up
    ip link add "v-$name" type veth peer name eth0 netns "$name"
    ip link set "v-$name" master br0 up
    ns "$name" ip addr add "198.18.0.$address/24" dev eth0
    ns "$name" ip link set eth0 up
    address=$((address + 1))
done

step "server and peers"
mkdir -p "$work/srv"
server new --network-name e2e --network-cidr 10.66.0.0/16 \
    --external-endpoint 198.18.0.1:51820 --listen-port 51820 >/dev/null
set_dns srv 127.0.0.1:5353 '["*"]'
# The admin commands of innernet-server go through the running server's coordinator.
ip netns exec srv "$E2E_BIN/innernet-server" -c "$work/srv/conf" -d "$work/srv/data" \
    serve e2e >>"$work/srv.log" 2>&1 &
pids+=("$!")
await_coordinator srv "$work/srv/conf/e2e.conf"
server add-cidr e2e --name peers --cidr 10.66.1.0/24 --parent e2e --yes >/dev/null
for peer in a b c; do
    server add-peer e2e --name "$peer" --auto-ip --cidr peers --admin false \
        --invite-expires 1h --save-config "$work/$peer.toml" --yes >/dev/null
done
for peer in a b c; do
    mkdir -p "$work/$peer"
    client "$peer" install "$work/$peer.toml" --default-name --listen-port 51820 \
        --delete-invite || fail "install $peer"
done
b_ip=$(field "$work/b/conf/e2e.conf" interface address)
b_ip=${b_ip%/*}
b_key=$(field "$work/b/conf/e2e.conf" interface private-key | wg pubkey)

step "b offers a nameserver at its own address"
# b claims a range besides its address, whose addresses its nameserver answers with. The
# nameserver answers for example.com, which stands in for b's hostname. It also answers for
# bank.com, a domain beyond b's, through an alias that points there, and with an address beyond
# b's delegation.
server add-delegation e2e --name b --prefix 10.66.1.32/28 --yes >/dev/null ||
    fail "add-delegation of b's range"
ns b dnsmasq --keep-in-foreground --no-resolv --no-hosts --bind-interfaces \
    --listen-address="$b_ip" --port=53 --user=root --group= --pid-file= \
    --host-record=example.com,10.66.1.35 --host-record=www.example.com,10.66.1.34 \
    --cname=alias.example.com,www.example.com \
    --host-record=bank.com,192.0.2.1 --cname=evil.example.com,bank.com \
    --host-record=outside.example.com,10.66.2.1 \
    --log-facility=- --log-queries >"$work/b.dnsmasq.log" 2>&1 &
pids+=("$!")
set_interface b announce-nameserver "\"$b_ip:53\""
set_interface b announce-zone '"example.com"'
client b fetch e2e || fail "fetch as b"
[ "$(sqlite3 "$work/srv/data/e2e.db" "SELECT count(*) FROM relayed_announcements WHERE public_key = (SELECT public_key FROM offered_names WHERE name = 'b')")" = 1 ] ||
    fail "the server holds no announcement of b"
client a fetch e2e || fail "fetch as a"
client a show e2e || fail "show as a"
grep -q "nameserver.*$b_ip:53 for example.com" "$work/a.log" ||
    fail "show doesn't list b's nameserver: $(cat "$work/a.log")"
pass "a accepts the nameserver that b announces"

step "a's daemon answers for b itself while it forwards to no peer"
set_dns a 127.0.0.1:5353
ns a "$E2E_BIN/innernet" -c "$work/a/conf" -d "$work/a/data" -v \
    up e2e --daemon --interval 2 >"$work/a.daemon.log" 2>&1 &
daemon=$!
pids+=("$daemon")
for _ in $(seq 30); do
    [ "$(dig_a +short b.e2e.wg A 2>/dev/null)" = "$b_ip" ] && break
    sleep 0.5
done
[ "$(dig_a +short b.e2e.wg A)" = "$b_ip" ] ||
    fail "a doesn't answer b.e2e.wg with b's address: $(dig_a b.e2e.wg A)"
dig_a www.b.e2e.wg A | grep -q "status: NXDOMAIN" ||
    fail "a forwards for b unasked: $(dig_a www.b.e2e.wg A)"
if grep -q "query\[" "$work/b.dnsmasq.log"; then
    fail "b's nameserver received a query: $(cat "$work/b.dnsmasq.log")"
fi
pass "a answers b.e2e.wg with b's address, and www.b.e2e.wg doesn't exist"

step "a's daemon forwards DNS for b to b's nameserver once its config selects every peer"
set_dns a 127.0.0.1:5353 '["*"]'
await_forwarding
pass "a resolves www.b.e2e.wg from b's nameserver"
[ "$(dig_a +short b.e2e.wg A)" = 10.66.1.35 ] || fail "a doesn't resolve b.e2e.wg: $(dig_a b.e2e.wg A)"
pass "a resolves b.e2e.wg as the apex of the zone"
[ "$(dig_a +short alias.b.e2e.wg A | tr '\n' ' ')" = "www.b.e2e.wg. 10.66.1.34 " ] ||
    fail "a doesn't restore the target of the alias: $(dig_a alias.b.e2e.wg A)"
pass "a restores the target of an alias to www.b.e2e.wg"
[ "$(dig_a +tcp +short www.b.e2e.wg A)" = 10.66.1.34 ] ||
    fail "a doesn't resolve www.b.e2e.wg over TCP: $(dig_a +tcp www.b.e2e.wg A)"
pass "a resolves www.b.e2e.wg over TCP"

step "b's nameserver speaks only for b's names"
evil=$(dig_a evil.b.e2e.wg A)
grep -qF 'bank.com.' <<<"$evil" || fail "b's nameserver didn't answer with the alias: $evil"
if grep -qF 192.0.2.1 <<<"$evil"; then
    fail "a passes on a record for bank.com from b's nameserver: $evil"
fi
pass "a drops the record for bank.com that b's nameserver adds"
outside=$(dig_a outside.b.e2e.wg A)
if grep -qF 10.66.2.1 <<<"$outside"; then
    fail "a passes on an address beyond b's delegation: $outside"
fi
pass "a drops the address beyond b's delegation that b's nameserver answers"
# a is authoritative for e2e.wg, the zone of the peers' names, and refuses names outside it.
dig_a www.c.e2e.wg A | grep -q "status: NXDOMAIN" ||
    fail "www.c.e2e.wg exists: $(dig_a www.c.e2e.wg A)"
pass "www.c.e2e.wg, under the name of a peer without a nameserver, doesn't exist"
apex=$(dig_a e2e.wg A)
grep -q "status: NOERROR" <<<"$apex" && [ -z "$(dig_a +short e2e.wg A)" ] ||
    fail "a doesn't answer the apex of the zone with no record: $apex"
pass "a answers the apex of the zone with no record"
for name in example.com bank.com; do
    dig_a "$name" A | grep -q "status: REFUSED" || fail "a doesn't refuse $name: $(dig_a "$name" A)"
    pass "a refuses $name"
done
ns a dig @127.0.0.1 -p 5353 +time=2 +tries=1 +opcode=notify www.b.e2e.wg SOA |
    grep -q "status: NOTIMP" || fail "a forwards a notification"
pass "a forwards only standard queries"

step "a answers for the peers that offer no nameserver itself"
for peer in a c; do
    ip=$(field "$work/$peer/conf/e2e.conf" interface address)
    [ "$(dig_a +short "$peer.e2e.wg" A)" = "${ip%/*}" ] ||
        fail "a doesn't answer $peer.e2e.wg with ${ip%/*}: $(dig_a "$peer.e2e.wg" A)"
done
dig_a c.e2e.wg A | grep -q "flags:.* aa" || fail "a's answer for c isn't authoritative"
[ -z "$(dig_a +short c.e2e.wg AAAA)" ] || fail "a answers c.e2e.wg with an IPv6 address"
pass "a answers a.e2e.wg and c.e2e.wg with their addresses"

step "the server's DNS server answers as a client's does"
dig_srv() { ns srv dig @127.0.0.1 -p 5353 +time=2 +tries=1 "$@"; }
for _ in $(seq 30); do
    [ "$(dig_srv +short www.b.e2e.wg A 2>/dev/null)" = 10.66.1.34 ] && break
    sleep 0.5
done
[ "$(dig_srv +short www.b.e2e.wg A)" = 10.66.1.34 ] ||
    fail "the server doesn't resolve www.b.e2e.wg: $(dig_srv www.b.e2e.wg A)"
c_ip=$(field "$work/c/conf/e2e.conf" interface address)
[ "$(dig_srv +short c.e2e.wg A)" = "${c_ip%/*}" ] ||
    fail "the server doesn't answer c.e2e.wg: $(dig_srv c.e2e.wg A)"
pass "the server forwards www.b.e2e.wg to b's nameserver, and answers c.e2e.wg itself"

step "the DNS server follows the config"
set_dns a 127.0.0.1:5354 '["*"]'
for _ in $(seq 20); do
    ns a dig @127.0.0.1 -p 5354 +time=1 +tries=1 +short www.b.e2e.wg A 2>/dev/null |
        grep -qx 10.66.1.34 && break
    sleep 0.5
done
ns a dig @127.0.0.1 -p 5354 +time=1 +tries=1 +short www.b.e2e.wg A | grep -qx 10.66.1.34 ||
    fail "the DNS server didn't move to the new listen address"
if dig_a +short www.b.e2e.wg A >/dev/null 2>&1; then
    fail "the DNS server still answers at the old listen address"
fi
pass "the DNS server moves to a new listen address"
set_dns a 127.0.0.1:5354 '["*", "!b"]'
for _ in $(seq 20); do
    ns a dig @127.0.0.1 -p 5354 +time=1 +tries=1 www.b.e2e.wg A 2>/dev/null |
        grep -q "status: NXDOMAIN" && break
    sleep 0.5
done
ns a dig @127.0.0.1 -p 5354 +time=1 +tries=1 www.b.e2e.wg A | grep -q "status: NXDOMAIN" ||
    fail "the DNS server still forwards for b once the config excludes it"
pass "the DNS server stops forwarding for b once the config excludes it, and keeps listening"
set_dns a
sleep 5
if ns a dig @127.0.0.1 -p 5354 +time=1 +tries=1 +short www.b.e2e.wg A >/dev/null 2>&1; then
    fail "the DNS server still answers once its table is removed"
fi
pass "the DNS server stops once its table is removed"

step "b withdraws its nameserver"
set_dns a 127.0.0.1:5353 '["b"]'
await_forwarding
set_interface b announce-nameserver
set_interface b announce-zone
client b fetch e2e || fail "fetch as b"
for _ in $(seq 20); do
    dig_a www.b.e2e.wg A | grep -q "status: NXDOMAIN" && break
    sleep 0.5
done
dig_a www.b.e2e.wg A | grep -q "status: NXDOMAIN" ||
    fail "a still forwards for b: $(dig_a www.b.e2e.wg A)"
pass "a stops forwarding for b once b no longer announces a nameserver"
[ "$(dig_a +short b.e2e.wg A)" = "$b_ip" ] ||
    fail "a doesn't answer b.e2e.wg with b's address: $(dig_a b.e2e.wg A)"
pass "a answers b.e2e.wg itself, with b's address"
kill "$daemon"
wait "$daemon" 2>/dev/null || true
