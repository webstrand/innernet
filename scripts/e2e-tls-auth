#!/usr/bin/env bash
# End-to-end test of TLS authentication of peers, run unprivileged in network namespaces.
#
# Usage: scripts/e2e-tls-auth [--keep]
#
# Topology, inside a private user, mount and network namespace:
#
#   198.18.0.0/24 "internet" (bridge in the outer namespace)
#     srv     198.18.0.1   innernet-server
#     a       198.18.0.2   peer with a current client
#     adm     198.18.0.3   admin with a current client
#     old     198.18.0.4   peer from before the server spoke TLS, with a client that predates TLS,
#                          upgraded midway
#     new     198.18.0.5   admin invitation redeemed by a client that predates TLS
#     osrv    198.18.0.6   a server that predates TLS, upgraded and downgraded midway
#     c       198.18.0.7   admin of osrv with a current client
#     probe   198.18.0.8   peer that requests the TLS API with wg(8) and curl(1) over HTTP/3,
#                          without a client key
#
# The TLS API runs in HTTP/3 over QUIC, at the server's internal address, on the QUIC port of the
# server's config; the legacy API runs in plain HTTP over TCP, on the listen port. Clients that
# predate TLS are played by wg(8) and curl(1) speaking plain HTTP, which is also what anything
# else on a peer's machine can do from the peer's innernet IP. The server that predates TLS is
# innernet-server 2.0.0, from the directory that E2E_ORIGIN_BIN names; without it, the steps that
# need it are skipped. The probe connects without a client key, as curl presents none, pins the
# server's key with --pinnedpubkey, and inspects the CBOR of the TLS API with Python's cbor2
# module.
#
# Requires: unshare, ip, wg, curl (with HTTP3), sqlite3, python3 (3.11+) with cbor2, and the
# kernel WireGuard module.
set -euo pipefail

if [ -z "${E2E_INSIDE:-}" ]; then
    top=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
    cargo build --offline --bins --manifest-path "$top/Cargo.toml" >&2
    exec unshare --user --map-root-user --mount --net \
        env E2E_INSIDE=1 E2E_BIN="${CARGO_TARGET_DIR:-$top/target}/debug" \
        E2E_ORIGIN_BIN="${E2E_ORIGIN_BIN:-}" \
        "$0" "$@"
fi

keep=0
[ "${1:-}" = --keep ] && keep=1

mount -t tmpfs tmpfs /run
umask 077
work=$(mktemp -d "${TMPDIR:-/tmp}/innernet-e2e.XXXXXX")
pids=()
cleanup() {
    local status=$?
    for pid in "${pids[@]}"; do kill "$pid" 2>/dev/null || true; done
    if [ "$status" -ne 0 ]; then
        echo "--- server log" >&2
        tail -n 30 "$work/srv.log" >&2 || true
    fi
    if [ "$keep" -eq 1 ] || [ "$status" -ne 0 ]; then
        echo "work directory kept: $work" >&2
    else
        rm -rf "$work"
    fi
}
trap cleanup EXIT

step() { printf '\n=== %s\n' "$*"; }
pass() { printf 'ok: %s\n' "$*"; }
fail() { printf 'FAIL: %s\n' "$*" >&2; exit 1; }

ns() { local name=$1; shift; ip netns exec "$name" "$@"; }

server() { ns srv "$E2E_BIN/innernet-server" -c "$work/srv/conf" -d "$work/srv/data" "$@"; }
client() {
    local peer=$1; shift
    ns "$peer" "$E2E_BIN/innernet" -c "$work/$peer/conf" -d "$work/$peer/data" "$@" \
        >"$work/$peer.log" 2>&1 || { cat "$work/$peer.log" >&2; return 1; }
}

# Waits until the coordinator of the server in the namespace `$1`, whose config is `$2`, listens
# for its API, which the admin commands of innernet-server reach it at.
await_coordinator() { # <namespace> <config>
    local port
    for _ in $(seq 50); do
        port=$(python3 -I -c 'import sys, tomllib
c = tomllib.load(open(sys.argv[1], "rb"))
print(c.get("coordinator", c).get("quic-port", ""))' "$2")
        if [ -n "$port" ] && ip netns exec "$1" ss -Hlun "sport = :$port" | grep -q .; then
            return 0
        fi
        sleep 0.2
    done
    echo "FAIL: the coordinator in $1 doesn't listen" >&2
    exit 1
}

db() { sqlite3 "$work/srv/data/e2e.db" "$@"; }

# Prints the public key in base64 as hex, as sqlite3 prints a blob.
key_hex() { python3 -I -c 'import base64, sys; print(base64.b64decode(sys.argv[1]).hex().upper())' "$1"; }
# Prints the condition that selects the peer with a public key, which a database holds as raw
# bytes, or, in the database of a server that predates the rebuild of its peers table, in base64.
by_key() { echo "(public_key = '$1' OR hex(public_key) = '$(key_hex "$1")')"; }
# Selects, in a database of this version's server, the peer to which the server offers the name
# `$1`.
offered() { echo "public_key = (SELECT public_key FROM offered_names WHERE name = '$1')"; }

# Serves a network in the background, recording the server's PID in $served. The server is
# started directly, not through a function, so that the PID is the server's own.
serve() { # <namespace> <innernet-server> <directory> <network> <log>
    ip netns exec "$1" "$2" -c "$3/conf" -d "$3/data" serve "$4" --no-write-hosts >>"$5" 2>&1 &
    served=$!
    pids+=("$served")
    sleep 1
}

expect_requires_tls() { # <peer> <0|1>
    local actual
    actual=$(db "SELECT tls FROM peers WHERE $(offered "$1")")
    [ "$actual" = "$2" ] || fail "$1's TLS latch is $actual, expected $2"
    pass "$1's TLS latch is $2"
}

# Prints a field of an invitation.
invitation() { # <invitation> <table> <key>
    python3 -I -c 'import sys, tomllib; print(tomllib.load(open(sys.argv[1], "rb"))[sys.argv[2]][sys.argv[3]])' "$@"
}

# Prints the source address that a client takes from an invitation, with the prefix of the
# network: the address that it names, or else the lowest address of the delegations that it
# offers.
invitation_address() { # <invitation>
    python3 -I - "$1" <<'EOF'
import ipaddress, sys, tomllib
interface = tomllib.load(open(sys.argv[1], "rb"))["interface"]
if "address" in interface:
    print(interface["address"])
else:
    network = ipaddress.ip_network(interface["network-cidr"])
    lowest = min(ipaddress.ip_network(d).network_address for d in interface["delegations"])
    print(f"{lowest}/{network.prefixlen}")
EOF
}

# Requests the API in plain HTTP from a namespace, printing the status and body.
plain() { # <namespace> <method> <path> [json body]
    local args=(-sS -o "$work/plain.body" -w '%{http_code}' -X "$2"
        -H "X-Innernet-Server-Key: $server_key")
    [ -n "${4:-}" ] && args+=(-H 'Content-Type: application/json' -d "$4")
    local status
    rm -f "$work/plain.body"
    status=$(ns "$1" curl "${args[@]}" "http://$api$3") || true
    touch "$work/plain.body"
    echo "$status $(cat "$work/plain.body")"
}

expect_plain() { # <namespace> <method> <path> <expected status> [json body]
    local response
    response=$(plain "$1" "$2" "$3" "${5:-}")
    [ "${response%% *}" = "$4" ] || fail "plain $2 $3 from $1 got '$response', expected $4"
    pass "plain $2 $3 from $1 got $4"
    last_body=${response#* }
}

# Joins with an invitation the way a client that predates TLS does: WireGuard with the
# invitation's key, then redemption in plain HTTP. Prints the redemption's status and body.
old_style_redeem() { # <namespace> <invitation>
    local peer=$1 invite=$2
    wg genkey >"$work/$peer.key"
    ns "$peer" ip link add wg0 type wireguard
    # Keys are piped, as wg(8) may be confined from opening files.
    invitation "$invite" interface private-key |
        ns "$peer" wg set wg0 private-key /dev/fd/0 listen-port 51820 \
            peer "$server_key" endpoint 198.18.0.1:51820 allowed-ips "${api%:*}/32" \
            persistent-keepalive 1
    ns "$peer" ip addr add "$(invitation_address "$invite")" dev wg0
    ns "$peer" ip link set wg0 up
    plain "$peer" POST /v1/user/redeem "{\"public_key\": \"$(wg pubkey <"$work/$peer.key")\"}"
}

# Prints the pin of a server's key for curl's --pinnedpubkey: the SHA-256, in base64, of the
# SubjectPublicKeyInfo of the Ed25519 form of the server's WireGuard key, with sign bit 0, which
# the server presents in its certificate.
pin() { # <WireGuard public key>
    python3 -I - "$1" <<'EOF'
import base64, hashlib, sys
p = 2**255 - 19
u = int.from_bytes(base64.b64decode(sys.argv[1]), "little")
y = (u - 1) * pow(u + 1, p - 2, p) % p
spki = bytes.fromhex("302a300506032b6570032100") + y.to_bytes(32, "little")
print(base64.b64encode(hashlib.sha256(spki).digest()).decode())
EOF
}

# The media type of version 1 of the TLS API, and the Accept that innernet sends.
v1='application/vnd.innernet+cbor; version=1'
accept_v1="$v1, application/problem+cbor"

# The problem type of a request that the server refuses without a client key.
client_key_required=urn:uuid:305a37cb-49a7-43e6-ac4e-999d31323fff

# Requests the TLS API over HTTP/3 from the probe, with curl, which presents no client key, so
# that the connection is anonymous, and which pins the server's key, with -k, since the pin
# replaces the verification of the self-signed certificate: sends <body file>, if any, as
# <content type>, with $accept as Accept, or no Accept if it is -, prints the status and the
# content type of the response, or - if it has none, and writes its body to $work/probe.body.
accept=$accept_v1
h3() { # <method> <path> [<content type> <body file>]
    local args=(-sS --http3-only -k --pinnedpubkey "sha256//$server_pin" -X "$1"
        -o "$work/probe.body" -w '%{http_code} %{content_type}')
    if [ "$accept" = - ]; then args+=(-H 'Accept:'); else args+=(-H "Accept: $accept"); fi
    [ -n "${3:-}" ] && args+=(-H "Content-Type: $3" --data-binary "@$4")
    local response
    response=$(ns probe curl "${args[@]}" "https://$quic$2") || return 1
    local status=${response%% *} content_type=${response#* }
    echo "$status ${content_type:--}"
}

expect_h3() { # <expected status> <expected content type> <method> <path> [...]
    local status=$1 content_type=$2 response
    shift 2
    response=$(h3 "$@") || fail "HTTP/3 $1 $2 from probe failed"
    [ "$response" = "$status $content_type" ] ||
        fail "HTTP/3 $1 $2 from probe got '$response', expected $status $content_type"
    pass "HTTP/3 $1 $2 from probe got $status $content_type"
}

# Checks that the body of the last response over HTTP/3 is a problem detail of a type, with a
# status, in deterministic CBOR.
expect_problem() { # <type> <status>
    python3 -I - "$work/probe.body" "$@" <<'EOF' || fail "the problem detail is not of type $1"
import cbor2, sys
body, problem_type, status = open(sys.argv[1], "rb").read(), sys.argv[2], int(sys.argv[3])
problem = cbor2.loads(body)
assert cbor2.dumps(problem, canonical=True) == body, "not in the deterministic encoding"
assert problem.get("type", "about:blank") == problem_type, problem
assert problem["status"] == status, problem
EOF
    pass "the problem detail is of type $1"
}

step "network"
ip link set lo up
ip link add br0 type bridge
ip link set br0 up
address=1
for name in srv a adm old new osrv c probe; do
    ip netns add "$name"
    ns "$name" ip link set lo up
    ip link add "v-$name" type veth peer name eth0 netns "$name"
    ip link set "v-$name" master br0 up
    ns "$name" ip addr add "198.18.0.$address/24" dev eth0
    ns "$name" ip link set eth0 up
    address=$((address + 1))
done

step "server"
mkdir -p "$work/srv"
server new --network-name e2e --network-cidr 10.66.0.0/16 \
    --external-endpoint 198.18.0.1:51820 --listen-port 51820 >/dev/null
# The admin commands of innernet-server go through the running server's coordinator.
serve srv "$E2E_BIN/innernet-server" "$work/srv" e2e "$work/srv.log"
await_coordinator srv "$work/srv/conf/e2e.conf"
server add-cidr e2e --name peers --cidr 10.66.1.0/24 --parent e2e --yes >/dev/null
for peer in a adm old new probe; do
    admin=false
    case $peer in adm | new) admin=true ;; esac
    server add-peer e2e --name "$peer" --auto-ip --cidr peers --admin "$admin" \
        --invite-expires 1h --save-config "$work/$peer.toml" --yes >/dev/null
done
# The server issued old's invitation before it spoke TLS, in the format of v2.0.0, which names the
# peer's address rather than offering delegations, and states neither features nor a QUIC port.
# The server latched the invitation, and the operator cleared the latch, so that a client that
# predates TLS can redeem it.
db "UPDATE peers SET tls = 0 WHERE $(offered old)"
python3 -I - "$work/old.toml" "$(invitation_address "$work/old.toml")" <<'EOF'
import re, sys
path, address = sys.argv[1:]
text = open(path).read()
text = re.sub(r'(?m)^(network-cidr|delegations|features|quic-port) = .*\n', '', text)
text = text.replace('[interface]\n', f'[interface]\naddress = "{address}"\n', 1)
open(path, "w").write(text)
EOF
server_key=$(invitation "$work/a.toml" server public-key)
server_pin=$(pin "$server_key")
api=$(invitation "$work/a.toml" server internal-endpoint)
quic_port=$(invitation "$work/a.toml" server quic-port)
quic="${api%:*}:$quic_port"

# Every peer that the server creates is latched from creation.
expect_requires_tls a 1
expect_requires_tls adm 1
expect_requires_tls new 1
expect_requires_tls old 0
[ "$(invitation "$work/a.toml" server features)" = "['tls']" ] ||
    fail "the invitation doesn't state that the server speaks TLS"
pass "the invitation states that the server speaks TLS"
grep -qx "quic-port = $quic_port" "$work/srv/conf/e2e.conf" ||
    fail "the invitation doesn't state the QUIC port of the server's config"
[ "$quic_port" != 51820 ] || fail "the QUIC port is the listen port"
pass "the invitation states the QUIC port of the server's config, $quic_port"

# Prints the QUIC port that a client's data store records for the coordinator.
recorded_port() { # <peer> <network>
    sqlite3 "$work/$1/data/$2.db" "SELECT quic_port FROM peers WHERE quic_port IS NOT NULL"
}

step "current clients install over QUIC"
for peer in a adm; do
    mkdir -p "$work/$peer"
    client "$peer" install "$work/$peer.toml" --default-name --listen-port 51820 \
        --delete-invite || fail "install $peer"
done
pass "a and adm installed"
expect_requires_tls a 1
[ "$(recorded_port a e2e)" = "$quic_port" ] || fail "a didn't record the QUIC port"
pass "a recorded the QUIC port of its invitation"
client a fetch e2e || fail "fetch as a"
pass "a fetches"
client adm list-associations e2e || fail "list associations as adm"
pass "adm uses the admin API"

step "anonymous connections use the public routes of the TLS API, in deterministic CBOR"
# The probe has the key of its invitation, which the server's interface knows, but no client
# for it: curl, which presents no client key, connects anonymously.
ns probe ip link add wg0 type wireguard
invitation "$work/probe.toml" interface private-key |
    ns probe wg set wg0 private-key /dev/fd/0 listen-port 51820 peer "$server_key" \
        endpoint 198.18.0.1:51820 allowed-ips "${api%:*}/32" persistent-keepalive 1
ns probe ip addr add "$(invitation_address "$work/probe.toml")" dev wg0
ns probe ip link set wg0 up
probe_key=$(invitation "$work/probe.toml" interface private-key | wg pubkey)
expect_h3 200 "$v1" GET /server
python3 -I - "$work/probe.body" "$server_key" <<'EOF' || fail "/server isn't as expected"
import cbor2, sys
body, key = open(sys.argv[1], "rb").read(), sys.argv[2]
server = cbor2.loads(body)
assert cbor2.dumps(server, canonical=True) == body, "not in the deterministic encoding"
assert server == {"public_key": key, "network_name": "e2e", "network_cidr": "10.66.0.0/16"}, server
EOF
pass "/server names the server's key, the network and its CIDR, as text"
expect_h3 200 "$v1" GET /whoami
probe_ip=$(invitation_address "$work/probe.toml")
python3 -I - "$work/probe.body" "$probe_key" "${probe_ip%/*}" <<'EOF' || fail "/whoami is wrong"
import cbor2, sys
body, key, address = open(sys.argv[1], "rb").read(), sys.argv[2], sys.argv[3]
whoami = cbor2.loads(body)
assert whoami == {"address": address, "authenticated": False, "public_key": key,
                  "name": "probe"}, whoami
EOF
pass "/whoami names the peer whose delegation holds the probe's address, unauthenticated"
expect_h3 200 "$v1" GET /capabilities
python3 -I - "$work/probe.body" "$quic_port" <<'EOF' || fail "/capabilities isn't as expected"
import cbor2, sys
body, port = open(sys.argv[1], "rb").read(), int(sys.argv[2])
capabilities = cbor2.loads(body)
assert capabilities["quic_port"] == port, capabilities
assert "unspecified_ip_in_override_endpoint" not in capabilities, capabilities
assert isinstance(capabilities["version"], str), capabilities
EOF
pass "/capabilities states the QUIC port and the server's version"

step "anonymous connections are refused every other route, before any other check"
python3 -I -c 'import cbor2, sys; sys.stdout.buffer.write(cbor2.dumps(["198.51.100.7:51820"]))' \
    >"$work/candidates.cbor"
for path in /user/state /admin/peers /v1/user/state /nothing; do
    expect_h3 403 application/problem+cbor GET "$path"
    expect_problem "$client_key_required" 403
done
expect_h3 403 application/problem+cbor PUT /user/candidates application/json \
    "$work/candidates.cbor"
expect_problem "$client_key_required" 403
expect_h3 403 application/problem+cbor PUT /server "$v1" "$work/candidates.cbor"
expect_problem "$client_key_required" 403
[ "$(db "SELECT count(*) FROM endpoints WHERE $(by_key "$probe_key")")" = 0 ] ||
    fail "the server stored the probe's candidate"
pass "the routes that need a client key, and unknown paths, are refused alike"

step "the TLS API answers in the version that the request accepts, or in a debug view"
printf '{}' >"$work/empty.json"
expect_h3 415 application/problem+cbor GET /server application/json "$work/empty.json"
expect_problem about:blank 415
accept='application/vnd.innernet+cbor; version=2, application/problem+cbor'
expect_h3 406 application/problem+cbor GET /server
expect_problem about:blank 406
accept="application/vnd.innernet+cbor; version=2, $v1; q=0.5, */*; q=0.1"
expect_h3 200 "$v1" GET /server
for accept in - '*/*' 'application/*'; do
    expect_h3 200 'application/vnd.innernet+cbor-diagnostic; version=1' GET /server
    [ "$(head -n 1 "$work/probe.body")" = "# unstable debug view; use Accept: $v1" ] ||
        fail "the debug view doesn't name the media type to ask for"
    grep -q '"network_name": "e2e"' "$work/probe.body" ||
        fail "the debug view doesn't show the network"
done
pass "the debug view answers the public routes"
accept=$accept_v1

step "curl refuses a server that presents another key than the pinned one"
if ns probe curl -sS --http3-only -k --pinnedpubkey "sha256//$(pin "$(wg genkey | wg pubkey)")" \
    -o /dev/null "https://$quic/server" 2>"$work/pin.log"; then
    fail "curl accepted a server key that it didn't pin"
fi
pass "curl refuses another key: $(head -n 1 "$work/pin.log")"

step "a current admin client addresses peers by public key over TLS"
client adm add-peer e2e --name x --auto-ip --cidr peers --admin false \
    --invite-expires 1h --save-config "$work/x.toml" --yes || fail "add-peer as adm"
x_key=$(invitation "$work/x.toml" interface private-key | wg pubkey)
x_peer() {
    db "SELECT o.name, p.is_disabled FROM peers p LEFT JOIN offered_names o USING (public_key)
        WHERE $(by_key "$x_key")"
}
[ "$(x_peer)" = "x|0" ] || fail "adm didn't add x"
pass "adm adds a peer"
# A TLS session has no routes by ID, so these succeed only by key.
client adm rename-peer e2e --name x --new-name y --yes || fail "rename-peer as adm"
client adm disable-peer e2e --name y --yes || fail "disable-peer as adm"
[ "$(x_peer)" = "y|1" ] || fail "adm didn't rename and disable x: $(x_peer)"
pass "adm renames and disables a peer by key"
client adm enable-peer e2e --name y --yes || fail "enable-peer as adm"
[ "$(x_peer)" = "y|0" ] || fail "adm didn't enable y: $(x_peer)"
pass "adm enables a peer by key"

step "a current admin client addresses CIDRs and associations by prefix over TLS"
# The server keys CIDRs by prefix, and associations by the prefixes of their CIDRs.
cidr_named() { db "SELECT hex(address) || '/' || prefix_len FROM cidrs WHERE name = '$1'"; }
client adm add-cidr e2e --name lab --cidr 10.66.2.0/24 --parent e2e --yes || fail "add-cidr as adm"
[ "$(cidr_named lab)" = "0A420200/24" ] || fail "adm didn't add lab: $(cidr_named lab)"
pass "adm adds a CIDR"
client adm rename-cidr e2e --name lab --new-name lab2 --yes || fail "rename-cidr as adm"
[ "$(cidr_named lab2)" = "0A420200/24" ] || fail "adm didn't rename lab"
pass "adm renames a CIDR by prefix"
client adm add-association e2e peers lab2 --yes || fail "add-association as adm"
[ "$(db "SELECT hex(address_1) || '/' || prefix_len_1 || ' ' || hex(address_2) || '/' || prefix_len_2 FROM associations")" = "0A420100/24 0A420200/24" ] ||
    fail "adm didn't associate peers and lab2"
client adm list-associations e2e || fail "list-associations as adm"
grep -q "peers <=> lab2" "$work/adm.log" || fail "adm doesn't list the association"
pass "adm associates two CIDRs by prefix, and lists the association"
client adm delete-association e2e lab2 peers --yes || fail "delete-association as adm"
[ "$(db "SELECT count(*) FROM associations")" = 0 ] || fail "adm didn't delete the association"
client adm delete-cidr e2e --name lab2 --yes || fail "delete-cidr as adm"
[ -z "$(cidr_named lab2)" ] || fail "adm didn't delete lab2"
pass "adm deletes an association and a CIDR by prefix"

step "delegations"
a_key=$(invitation "$work/a/conf/e2e.conf" interface private-key | wg pubkey)
# Prints the allowed IPs that a client's interface routes to a key.
routed() { # <peer> <key>
    ns "$1" wg show e2e allowed-ips | awk -v key="$2" '$1 == key { $1 = ""; print substr($0, 2) }'
}
# Prints the number of pins of a key in a client's data store.
pins() { # <peer> <key>
    sqlite3 "$work/$1/data/e2e.db" \
        "SELECT count(*) FROM prefix_pins WHERE hex(public_key) = '$(key_hex "$2")'"
}

server add-peer e2e --name w --delegation 10.66.1.32/28 --cidr peers --admin false \
    --invite-expires 1h --save-config "$work/w.toml" --yes >/dev/null || fail "add-peer w"
[ "$(invitation "$work/w.toml" interface delegations)" = "['10.66.1.32/28']" ] ||
    fail "w's invitation doesn't offer its delegation"
[ "$(invitation_address "$work/w.toml")" = "10.66.1.32/16" ] ||
    fail "w's invitation names an address"
pass "the server invites w with a /28, without naming an address"

client adm add-delegation e2e --name a --prefix 10.66.1.64/28 --yes || fail "add-delegation as adm"
[ "$(db "SELECT count(*) FROM delegations WHERE $(by_key "$a_key")")" = 2 ] ||
    fail "adm didn't delegate 10.66.1.64/28 to a"
for peer in a adm; do
    client "$peer" fetch e2e || fail "fetch as $peer"
done
routed adm "$a_key" | grep -qF 10.66.1.64/28 || fail "adm doesn't route a's delegation to a"
pass "adm delegates a prefix to a, and routes it to a"
ns a ip addr add 10.66.1.70/32 dev e2e
ns adm ping -c1 -W2 10.66.1.70 >/dev/null || fail "adm can't reach a within its delegation"
pass "adm reaches a at an address of its delegation"

client adm withdraw-delegation e2e --name a --prefix 10.66.1.64/28 --yes ||
    fail "withdraw-delegation as adm"
client adm fetch e2e || fail "fetch as adm"
if routed adm "$a_key" | grep -qF 10.66.1.64/28; then
    fail "adm still routes the withdrawn delegation to a"
fi
[ "$(pins adm "$a_key")" = 2 ] || fail "adm doesn't keep the withdrawn delegation pinned to a"
pass "the withdrawn delegation is no longer routed, but stays pinned to a"

if server withdraw-delegation e2e --name innernet-server --prefix 10.66.0.1/32 --yes \
    >"$work/withdraw.log" 2>&1; then
    fail "the server withdrew the delegation of its internal address"
fi
grep -q "internal address" "$work/withdraw.log" || fail "the refusal doesn't explain itself"
pass "the server keeps the delegation of its internal address"

step "something else on a peer's machine, without its key"
expect_plain a GET /v1/user/state 401
case $last_body in *TLS*) pass "the refusal explains TLS is required" ;;
    *) fail "the refusal doesn't explain TLS is required: $last_body" ;; esac
# The admin API exists only over TLS.
expect_plain adm GET /v1/admin/peers 404
expect_plain adm POST /v1/admin/peers 404 '{}'
# Only the capabilities, which state the QUIC port, are information enough to answer.
expect_plain a GET /v1/user/capabilities 200
case $last_body in *"\"quic_port\":$quic_port"*) pass "the capabilities state the QUIC port" ;;
    *) fail "the capabilities don't state the QUIC port: $last_body" ;; esac

step "a client that predates TLS can't redeem an invitation that the server issued since"
response=$(old_style_redeem new "$work/new.toml")
[ "${response%% *}" = 401 ] || fail "old-style redemption of a new invitation got '$response'"
pass "old-style redemption of a new invitation got 401"
expect_requires_tls new 1
db "SELECT is_redeemed FROM peers WHERE $(offered new)" | grep -qx 0 ||
    fail "the new invitation was redeemed"
pass "the new invitation is still unredeemed"

step "a client that predates TLS keeps working with an invitation from before"
response=$(old_style_redeem old "$work/old.toml")
[ "${response%% *}" = 204 ] || fail "old-style redemption got '$response'"
pass "old-style redemption got 204"
cat "$work/old.key" | ns old wg set wg0 private-key /dev/fd/0
# The server switches to the new key 5 s after redeeming.
sleep 6
expect_plain old GET /v1/user/state 200
expect_plain old GET /v1/admin/peers 404
expect_requires_tls old 0

step "once upgraded, it can't be impersonated in plain HTTP"
ns old ip link del wg0
mkdir -p "$work/old/conf" "$work/old/data"
python3 -I - "$work/old.toml" "$work/old/conf/e2e.conf" "$(cat "$work/old.key")" <<'EOF'
import re, sys
invite, config, key = sys.argv[1:]
text = open(invite).read()
text = re.sub(r'(?m)^private-key = ".*"$', f'private-key = "{key}"', text)
open(config, "w").write(text)
EOF
client old up e2e || fail "up as the upgraded old"
pass "the upgraded old fetches"
# Its invitation states no QUIC port, so it asked the server for it, in plain HTTP.
[ "$(recorded_port old e2e)" = "$quic_port" ] ||
    fail "the upgraded old didn't record the QUIC port that the server states"
pass "the upgraded old learned the QUIC port from the capabilities, and recorded it"
expect_requires_tls old 1
expect_plain old GET /v1/user/state 401
client old fetch e2e || fail "fetch as the upgraded old"
pass "the upgraded old keeps fetching over TLS"

if [ -z "$E2E_ORIGIN_BIN" ]; then
    step "SKIPPED: a server that predates TLS (E2E_ORIGIN_BIN is unset)"
    exit 0
fi

origin_server() {
    ns osrv "$E2E_ORIGIN_BIN/innernet-server" -c "$work/osrv/conf" -d "$work/osrv/data" "$@"
}
serve_osrv() { # <directory of innernet-server>
    serve osrv "$1/innernet-server" "$work/osrv" e2o "$work/osrv.log"
    osrv_pid=$served
}
stop_osrv() {
    kill "$osrv_pid"
    wait "$osrv_pid" 2>/dev/null || true
}
client_latched() { # <peer>
    sqlite3 "$work/$1/data/e2o.db" "SELECT count(*) FROM peers WHERE tls = 1"
}

step "a current client with a server that predates TLS"
mkdir -p "$work/osrv"
origin_server new --network-name e2o --network-cidr 10.67.0.0/16 \
    --external-endpoint 198.18.0.6:51820 --listen-port 51820 >/dev/null
origin_server add-cidr e2o --name peers --cidr 10.67.1.0/24 --parent e2o --yes >/dev/null
origin_server add-peer e2o --name c --auto-ip --cidr peers --admin true \
    --invite-expires 1h --save-config "$work/c.toml" --yes >/dev/null
origin_server add-peer e2o --name d --auto-ip --cidr peers --admin false \
    --invite-expires 1h --save-config "$work/d.toml" --yes >/dev/null
d_key=$(invitation "$work/d.toml" interface private-key | wg pubkey)
osrv_db() { sqlite3 "$work/osrv/data/e2o.db" "$@"; }
d_peer() { osrv_db "SELECT name, is_disabled FROM peers WHERE $(by_key "$d_key")"; }
serve_osrv "$E2E_ORIGIN_BIN"
mkdir -p "$work/c"
client c install "$work/c.toml" --default-name --listen-port 51820 --delete-invite ||
    fail "install c with the server that predates TLS"
grep -q "predates TLS" "$work/c.log" || fail "c didn't warn that it uses plain HTTP"
pass "c installed in plain HTTP, with a warning"
client c fetch e2o || fail "fetch as c"
[ "$(client_latched c)" = 0 ] || fail "c latched a server that predates TLS"
pass "c fetches in plain HTTP, unlatched"
# The server that predates TLS addresses peers only by ID.
client c rename-peer e2o --name d --new-name d2 --yes || fail "rename-peer as c in plain HTTP"
client c disable-peer e2o --name d2 --yes || fail "disable-peer as c in plain HTTP"
[ "$(d_peer)" = "d2|1" ] || fail "c didn't rename and disable d: $(d_peer)"
pass "c renames and disables a peer by ID in plain HTTP"
if client c add-delegation e2o --name d2 --prefix 10.67.1.32/28 --yes; then
    fail "c delegated a prefix through a server that predates TLS"
fi
grep -q "single address only" "$work/c.log" || fail "c's refusal doesn't explain itself"
pass "c refuses to delegate a prefix through a server that predates TLS"
# The server that predates TLS addresses CIDRs and associations only by ID.
client c add-cidr e2o --name tmp --cidr 10.67.3.0/24 --parent e2o --yes ||
    fail "add-cidr of tmp as c in plain HTTP"
client c rename-cidr e2o --name tmp --new-name tmp2 --yes || fail "rename-cidr as c in plain HTTP"
[ "$(osrv_db "SELECT ip, prefix FROM cidrs WHERE name = 'tmp2'")" = "10.67.3.0|24" ] ||
    fail "c didn't add and rename tmp"
client c delete-cidr e2o --name tmp2 --yes || fail "delete-cidr as c in plain HTTP"
[ -z "$(osrv_db "SELECT id FROM cidrs WHERE name = 'tmp2'")" ] || fail "c didn't delete tmp2"
pass "c adds, renames and deletes a CIDR by ID in plain HTTP"
client c add-cidr e2o --name lab --cidr 10.67.2.0/24 --parent e2o --yes ||
    fail "add-cidr as c in plain HTTP"
client c add-association e2o peers lab --yes || fail "add-association as c in plain HTTP"
client c list-associations e2o || fail "list-associations as c in plain HTTP"
grep -q "peers <=> lab" "$work/c.log" || fail "c doesn't list the association"
[ "$(osrv_db "SELECT count(*) FROM associations")" = 1 ] || fail "c didn't associate peers and lab"
pass "c associates two CIDRs by ID in plain HTTP"

step "the server is upgraded"
names=$(osrv_db "SELECT name FROM peers ORDER BY name")
cidr_names=$(osrv_db "SELECT name FROM cidrs ORDER BY name")
stop_osrv
# Nothing writes the config: the upgraded server refuses the config of innernet-server 2.0.0,
# which states no QUIC port, and suggests a free one. The operator adds a UDP port that it finds
# free itself. innernet-server 2.0.0 ignores the key.
if ns osrv "$E2E_BIN/innernet-server" -c "$work/osrv/conf" -d "$work/osrv/data" serve e2o \
    --no-write-hosts >"$work/osrv.refusal.log" 2>&1; then
    fail "the upgraded server started without a QUIC port"
fi
grep -q "states no quic-port" "$work/osrv.refusal.log" ||
    fail "the upgraded server doesn't explain its refusal: $(cat "$work/osrv.refusal.log")"
chosen_port=$(ns osrv python3 -I -c '
import socket
while True:
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as udp:
        udp.bind(("", 0))
        port = udp.getsockname()[1]
    if port != 51820:
        print(port)
        break')
echo "quic-port = $chosen_port" >>"$work/osrv/conf/e2o.conf"
pass "the upgraded server refuses a config without a QUIC port, and the operator adds one"
serve_osrv "$E2E_BIN"
[ "$(osrv_db "SELECT name FROM offered_names ORDER BY name")" = "$names" ] ||
    fail "the upgraded server didn't keep every peer"
pass "the upgraded server keeps every peer"
[ "$(osrv_db "SELECT name FROM cidrs ORDER BY name")" = "$cidr_names" ] ||
    fail "the upgraded server didn't keep every CIDR"
pass "the upgraded server keeps every CIDR"
# Prints the QUIC port of osrv's config.
osrv_quic_port() { sed -n 's/^quic-port = //p' "$work/osrv/conf/e2o.conf"; }
client c fetch e2o || fail "fetch as c from the upgraded server"
[ "$(client_latched c)" = 1 ] || fail "c didn't latch the upgraded server"
pass "c fetches over TLS, and latched the server"
[ "$(recorded_port c e2o)" = "$(osrv_quic_port)" ] || fail "c didn't record the QUIC port"
pass "c learned the QUIC port from the capabilities, and recorded it"
[ -f "$work/osrv/data/e2o.db.v2.0.0" ] || fail "the upgraded server didn't back up its database"
pass "the upgraded server backed up its database before rebuilding it"
# The upgraded server's database offers each peer its name apart.
d_peer() {
    osrv_db "SELECT o.name, p.is_disabled FROM peers p LEFT JOIN offered_names o USING (public_key)
             WHERE $(by_key "$d_key")"
}
[ "$(osrv_db "SELECT tls FROM peers WHERE $(offered c)")" = 1 ] ||
    fail "the upgraded server didn't latch c"
pass "the upgraded server latched c"
client c rename-peer e2o --name d2 --new-name d3 --yes || fail "rename-peer as c over TLS"
client c enable-peer e2o --name d3 --yes || fail "enable-peer as c over TLS"
[ "$(d_peer)" = "d3|0" ] || fail "c didn't rename and enable d: $(d_peer)"
pass "c renames and enables a peer by key over TLS"
client c rename-cidr e2o --name lab --new-name lab2 --yes || fail "rename-cidr as c over TLS"
client c delete-association e2o peers lab2 --yes || fail "delete-association as c over TLS"
[ "$(osrv_db "SELECT count(*) FROM associations")" = 0 ] || fail "c didn't delete the association"
client c delete-cidr e2o --name lab2 --yes || fail "delete-cidr as c over TLS"
[ "$(osrv_db "SELECT count(*) FROM cidrs WHERE name LIKE 'lab%'")" = 0 ] ||
    fail "c didn't rename and delete lab"
pass "c renames and deletes a CIDR and an association by prefix over TLS"

step "the server is downgraded"
stop_osrv
# The server that predates TLS can't read the rebuilt database, so the operator restores the copy
# that the upgrade made. It ignores the QUIC port of the config.
cp "$work/osrv/data/e2o.db.v2.0.0" "$work/osrv/data/e2o.db"
serve_osrv "$E2E_ORIGIN_BIN"
if client c fetch e2o; then
    fail "c fell back to plain HTTP for a server that it knows speaks TLS"
fi
grep -q "known to speak TLS" "$work/c.log" || fail "c's refusal doesn't explain the latch"
pass "c refuses the downgraded server"

step "the server is upgraded again, with another QUIC port"
stop_osrv
# The operator moves the QUIC port, which c has recorded.
old_port=$(osrv_quic_port)
new_port=$((old_port == 4433 ? 4434 : 4433))
sed -i "s/^quic-port = .*/quic-port = $new_port/" "$work/osrv/conf/e2o.conf"
serve_osrv "$E2E_BIN"
client c fetch e2o || fail "fetch as c from the server upgraded again"
pass "the server upgraded again rebuilds the restored database, and c fetches over TLS"
[ "$(recorded_port c e2o)" = "$new_port" ] || fail "c didn't learn the new QUIC port"
pass "c found nothing at $old_port, asked the server for the port again, and recorded $new_port"
[ -f "$work/osrv/data/e2o.db.v2.0.0.1" ] ||
    fail "the server upgraded again didn't back up its database next to the first backup"
pass "the server upgraded again keeps the first backup, and makes another"

step "the legacy API is turned off"
stop_osrv
echo "legacy-api = false" >>"$work/osrv/conf/e2o.conf"
serve_osrv "$E2E_BIN"
client c fetch e2o || fail "fetch as c without the legacy API"
pass "c fetches over QUIC"
api=$(invitation "$work/c/conf/e2o.conf" server internal-endpoint) \
    server_key=$(invitation "$work/c/conf/e2o.conf" server public-key) \
    expect_plain c GET /v1/user/capabilities 000
pass "nothing serves plain HTTP"

step "all passed"
